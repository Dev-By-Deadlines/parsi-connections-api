### 

@base = http://localhost:5000


### Create a new puzzle

POST {{base}}/puzzles HTTP/1.1
Content-Type: application/json

{
  "categories": [
    {
      "name": "Famous Scientists",
      "words": [
        {
          "text": "Newton"
        },
        {
          "text": "Einstein"
        },
        {
          "text": "Curie"
        },
        {
          "text": "Darwin"
        }
      ]
    },
    {
      "name": "Capital Cities",
      "words": [
        {
          "text": "London"
        },
        {
          "text": "Paris"
        },
        {
          "text": "Tokyo"
        },
        {
          "text": "Berlin"
        }
      ]
    },
    {
      "name": "Programming Languages",
      "words": [
        {
          "text": "C#"
        },
        {
          "text": "Python"
        },
        {
          "text": "JavaScript"
        },
        {
          "text": "Rust"
        }
      ]
    },
    {
      "name": "Musical Instruments",
      "words": [
        {
