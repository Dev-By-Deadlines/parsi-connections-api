        }
      ]
    }
  ]
}


### Get all puzzles (admin overview)

GET {{base}}/puzzles HTTP/1.1
Accept: application/json


### Get a single puzzle (replace 1 with the actual id from creation response)

GET {{base}}/puzzles/1 HTTP/1.1
Accept: application/json


### 

DELETE {{base}}/puzzles/1 HTTP/1.1
Accept: application/json
